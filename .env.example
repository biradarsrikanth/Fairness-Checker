# Copy to .env and fill in. .env is git-ignored and never copied into the Docker image.

# Azure Database Configuration
AZURE_DB_URL=jdbc:postgresql://<server>.postgres.database.azure.com:5432/postgres?sslmode=require
AZURE_DB_USERNAME=
AZURE_DB_PASSWORD=

# Supabase Database Configuration
DB_PASSWORD=
DB_URL=
DB_USERNAME=

# PagerDuty Configuration
PAGERDUTY_API_TOKEN=
PAGERDUTY_BASE_URL=https://api.pagerduty.com
PAGERDUTY_INTEGRATION_KEY=
PAGERDUTY_WEBHOOK_SECRET=

# Scheduler Configuration (milliseconds between syncs)
PAGERDUTY_SYNC_RATE=3000000

# Scorer: same SCORER_API_KEY value as in fairneess-scorer/.env, at least 32 characters
# (e.g. `openssl rand -hex 32`). PYTHON_SCORER_URL is only needed outside Docker Compose;
# the compose file sets it to http://scorer:8000.
SCORER_API_KEY=
PYTHON_SCORER_URL=http://127.0.0.1:8000

# Auth: secret that signs access tokens, at least 32 characters (e.g. `openssl rand -base64 48`).
# Keep it stable: changing it signs everyone out. Token lifetimes have defaults (see application.properties).
JWT_SECRET=

# First admin, created at startup while there are no users; must change the password at first sign-in.
# Password: at least 12 characters. Remove it once the admin exists.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# API docs (Swagger UI at /swagger-ui.html, spec at /v3/api-docs). Set to false to hide them.
API_DOCS_ENABLED=true
